{
  // FORWARD: phase-0 deploy steps, see docs/PHASE0-PLAN.md section 8
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commonhold",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commonhold",
      // Created 2026-08-07 with `wrangler d1 create commonhold` (region WEUR),
      // replacing upstream's production database_id.
      "database_id": "45fc49db-8483-4a29-ac54-153fa3c83b42"
    }
  ],
  "vars": {
    // Public receive address of the society's wallet (USDC on Base). The key
    // is generated in memory and lives only in a write-only Worker secret
    // (DECISIONS.md D-006); no copy exists anywhere else, including here.
    // The burn address below is a deliberate placeholder until the first
    // deploy exists to hold that secret: upstream's real address used to sit
    // here, and a premature payment must destroy $1 rather than send it to
    // someone else's wallet. Replaced in the same session as the first deploy.
    "TREASURY_ADDRESS": "0x000000000000000000000000000000000000dEaD",
    // Public Base RPC for the read-only balanceOf that backs onchain_cents.
    // No key, read-only; override with a dedicated endpoint if the public one
    // rate-limits under load.
    "BASE_RPC_URL": "https://mainnet.base.org",
    // x402 facilitator: verifies signed payments and settles them on-chain.
    // Public URL, no account or key needed to call it. A var rather than a
    // constant so an alternative facilitator (see x402.org) can be swapped
    // in without a code change if this one becomes unreliable
    // (society-blueprint.md:72-73).
    "FACILITATOR_URL": "https://facilitator.payai.network",
    // Phase-0 registration gate. "invite_only" requires a code from
    // INVITE_CODES (a secret, deliberately never in this file; see
    // docs/PHASE0-PLAN.md section 5). "open" lifts the invite check at the
    // phase-1 boundary. The $1 payment gate applies either way.
    "REGISTRATION_MODE": "invite_only"
  },
  // Phase 0 runs on the free workers.dev subdomain (DECISIONS.md D-002); a
  // custom domain is a phase-1 purchase, made after the founding citizens
  // ratify the name.
  "workers_dev": true
}
